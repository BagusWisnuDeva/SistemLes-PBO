<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tk2pbo.controller.LaporanController" spacing="10" styleClass="halaman">
    <padding>
        <Insets top="22" right="22" bottom="22" left="22"/>
    </padding>
    <Label text="Laporan" styleClass="judul-halaman"/>
    <Label text="Pilih jenis laporan, atur filter yang diperlukan, lalu tekan Tampilkan." styleClass="keterangan"/>
    <HBox spacing="10" alignment="BOTTOM_LEFT">
        <VBox spacing="4">
            <Label text="Jenis laporan" styleClass="label-field"/>
            <ComboBox fx:id="cbJenis" prefWidth="190"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Kursus (laporan pendaftaran)" styleClass="label-field"/>
            <ComboBox fx:id="cbKursus" prefWidth="190" promptText="Semua kursus"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Pengajar (laporan jadwal)" styleClass="label-field"/>
            <ComboBox fx:id="cbPengajar" prefWidth="190" promptText="Semua pengajar"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Dari tanggal (pendapatan)" styleClass="label-field"/>
            <DatePicker fx:id="dpDari" prefWidth="140"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Sampai tanggal" styleClass="label-field"/>
            <DatePicker fx:id="dpSampai" prefWidth="140"/>
        </VBox>
    </HBox>
    <HBox spacing="10">
        <Button text="Tampilkan" onAction="#tampilkan" styleClass="tombol-utama"/>
        <Button text="Ekspor CSV" onAction="#ekspor" styleClass="tombol-netral"/>
        <Button text="Reset Filter" onAction="#resetFilter" styleClass="tombol-netral"/>
    </HBox>
    <Label fx:id="lblJudul" text="" styleClass="judul-kecil"/>
    <TableView fx:id="tabel" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <Label fx:id="lblRingkasan" text="" styleClass="ringkasan" wrapText="true"/>
</VBox>
