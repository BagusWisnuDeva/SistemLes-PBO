<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="login-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tk2pbo.controller.LoginController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="420.0" spacing="14.0" styleClass="login-card" StackPane.alignment="CENTER">
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
         </padding>
         <children>
            <Label styleClass="judul" text="Sistem Pendaftaran Kursus / Les Privat" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="Arial Bold" size="18.0" />
               </font>
            </Label>
            <Label styleClass="sub" text="Masuk untuk melanjutkan" />
            <Label text="Masuk sebagai">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <ComboBox fx:id="cmbPeran" maxWidth="Infinity" promptText="Admin" />
            <Label text="Username">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <TextField fx:id="txtUsername" maxWidth="Infinity" promptText="Username" />
            <Label text="Password">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <PasswordField fx:id="txtPassword" maxWidth="Infinity" promptText="Password" />
            <Button fx:id="btnMasuk" maxWidth="Infinity" mnemonicParsing="false" onAction="#masuk" styleClass="tombol-utama" text="Masuk" />
         </children>
      </VBox>
   </children>
</StackPane>
